{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "my-emdash-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
"observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true}.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-emdash-site","database_id": "7c2fd4b4-c67f-45ab-8e40-36483f384359",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "my-emdash-media","preview_bucket_name": "my-emdash-media",
		},
	],


	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	 "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
